# Copy to .env and fill in what you use. Everything works with the defaults (scripted model,
# email dry run). Never commit .env.

# ---- model: scripted | groq | openrouter | gemini | ollama ----
LLM_PROVIDER=scripted
LLM_MODEL=
LLM_API_KEY=
# For Ollama in Docker Compose: http://ollama:11434/v1 ; on your machine: http://localhost:11434/v1
LLM_BASE_URL=

# ---- guardrail rules (docs/GUARDRAILS.md) ----
MAX_DISCOUNT_PCT=10
DISCOUNT_MIN_CART_VALUE=999
RETURN_WINDOW_DAYS=15
REFUNDS_NEED_APPROVAL=true
MAX_AGENT_STEPS=6
RECOVERY_MAX_PER_CART=1
RECOVERY_COOLDOWN_HOURS=24
ABANDON_AFTER_MINUTES=60

# ---- public demo limits (each chat message spends free model quota) ----
CHAT_LIMIT_PER_VISITOR=30
CHAT_DAILY_LIMIT=300

# ---- secrets (change all of these outside your laptop) ----
STORE_API_KEY=dev-store-key
STORE_WEBHOOK_SECRET=dev-webhook-secret
ADMIN_TOKEN=dev-admin-token
CORS_ORIGINS=http://localhost:5173

# ---- shopper emails: come-back email for a left cart, order confirmation (outbound only) ----
# Gmail: turn on 2-step verification, then create an app password.
# Empty address or password = dry run: emails are recorded in the outbox table, nothing is sent.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# Sender shown to shoppers (optional), e.g. you+kesarlane@gmail.com
EMAIL_FROM=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
# Any address gets at most this many emails a day (visitors can type any address into the demo)
EMAIL_DAILY_LIMIT_PER_ADDRESS=5
# Demo: seeded shoppers have undeliverable addresses; this links your own address to one of them
DEMO_LINKED_EMAIL=
DEMO_LINKED_CUSTOMER=C0001
# Public URLs used inside emails (unsubscribe link, link back to the chat); Render sets RENDER_EXTERNAL_URL
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:5173
